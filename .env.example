# CloudPrune AI Environment Configuration

# Server Port
PORT=3001

# Google Gemini API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Supabase configuration (for persistent enterprise telemetry)
# Get your project URL and anon key from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
